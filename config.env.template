# =============================================================================
# MongoDB Atlas vs ElastiCache Redis — Benchmark Configuration
# =============================================================================
# Copy this file to config.env and fill in your values:
#   cp config.env.template config.env
# =============================================================================

# --- AWS (for EC2 + ElastiCache) ---
AWS_PROFILE="your-aws-sso-profile"
AWS_REGION="eu-west-2"

# --- AWS Resource Tags ---
TAG_OWNER="your-name"
TAG_PURPOSE="benchmark"
TAG_EXPIRE_ON=""  # YYYY-MM-DD format, leave empty for tomorrow's date

# --- Atlas API Credentials ---
ATLAS_PUBLIC_KEY="your-public-key"
ATLAS_PRIVATE_KEY="your-private-key"
ATLAS_PROJECT_ID="your-project-id"

# --- Atlas Cluster Configuration ---
ATLAS_CLUSTER_NAME="bench-atlas-m30"
ATLAS_INSTANCE_SIZE="M30"
ATLAS_REGION="EU_WEST_2"

# --- Database User (created by Terraform) ---
DB_USERNAME="benchuser"
DB_PASSWORD="BenchmarkPass123!"

# --- Benchmark Parameters ---
SMALL_RECORD_COUNT="5000000"
LARGE_RECORD_COUNT="20000000"
THREAD_COUNTS="32 128 256"
RUN_DURATION_SECONDS="180"
WARMUP_SECONDS="30"
COOLDOWN_SECONDS="30"

# --- Pricing (per hour, eu-west-2 on-demand) ---
# Atlas M30 Gen1: $0.59/hr (3-node replica set, price is per cluster)
ATLAS_HOURLY_COST_PER_NODE="0.59"
ATLAS_NODE_COUNT="1"
# ElastiCache cache.r6g.large: $0.24/hr per node × 2 nodes = $0.48/hr
REDIS_HOURLY_COST_PER_NODE="0.24"
REDIS_NODE_COUNT="2"

# --- EC2 Benchmark Client ---
EC2_INSTANCE_TYPE="c5.2xlarge"
